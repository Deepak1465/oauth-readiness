# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin one model. By default the agent tries gemini-3.6-flash, gemini-3.8-flash, gemini-3.5-flash-lite in turn.
GEMINI_MODEL=
# Optional: free-tier search API (https://tavily.com). Makes live research more reliable than keyless search.
TAVILY_API_KEY=
# Optional, for durable share links when deployed (Upstash Redis free tier, e.g. via Vercel Marketplace).
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted. Without these, live guides save to data/generated/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
